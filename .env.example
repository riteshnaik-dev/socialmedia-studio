# Copy this file to .env for running on your own computer.
# On Spaceship, enter these same names and values as environment variables
# in cPanel > Setup Node.js App instead. Never commit the real .env file.

# The password you type to sign in.
APP_PASSWORD=choose-a-long-password

# A long random string used to sign the sign-in cookie. Any 40+ random characters.
SESSION_SECRET=replace-with-a-long-random-string
